# atf backend — host/local config. Copy to .env.local (gitignored) and `source` it:
#     cp .env.local.example .env.local && $EDITOR .env.local && source .env.local
# then run:  atf web   (or: make web)

# At-rest encryption key for secrets in the config store (Fernet). MUST be stable — if it
# changes, stored secrets can't be decrypted. Use 32+ random chars in production.
export APP_SECRET="change-me-to-a-long-random-32-plus-char-secret"

# SQLite store location. `file:PATH` (URL-style) or a bare path. Default: reports/atf.db
export DATABASE_URL="file:reports/atf.db"

# Only needed when the BROWSER reaches the app from another host (drives CORS + is the
# eventual deploy target). Leave unset for local 127.0.0.1 access.
# export PUBLIC_HOST="192.0.2.10"
